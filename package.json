{
  "name": "dreamatic-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch apps/server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx apps/server/src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import ./tests/setup.mjs --import tsx --test tests/*.test.ts",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.md",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.1.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "grapesjs": "^0.22.12",
    "image-size": "2.0.4",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "officeparser": "^8.1.1",
    "playwright-core": "^1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typebox": "1.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
