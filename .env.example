PORT=4310
HOST=127.0.0.1
DREAMATIC_MODE=live
DREAMATIC_LANGUAGE=zh
# Prefer the grouped Models & settings dialog. Saved settings take precedence.
# OpenAI mode uses Responses; openai-compatible uses Chat Completions.
DREAMATIC_MODEL_MODE=openai
DREAMATIC_BASE_URL=
DREAMATIC_MODEL=
DREAMATIC_API_KEY=
DREAMATIC_VISION=true
# Optional complete overrides. Leave unset to inherit the reasoning profile.
DREAMATIC_ANALYST_MODEL_MODE=openai-compatible
DREAMATIC_ANALYST_BASE_URL=
DREAMATIC_ANALYST_MODEL=
DREAMATIC_ANALYST_API_KEY=
DREAMATIC_ANALYST_VISION=true
DREAMATIC_DESIGNER_MODEL_MODE=openai-compatible
DREAMATIC_DESIGNER_BASE_URL=
DREAMATIC_DESIGNER_MODEL=
DREAMATIC_DESIGNER_API_KEY=
DREAMATIC_DESIGNER_VISION=true
DREAMATIC_SKILL_PATHS=
DREAMATIC_ACCESS_TOKEN=
# Total per-role execution limit in milliseconds; 0 disables the total deadline.
DREAMATIC_AGENT_TIMEOUT_MS=0
# Normal role execution limits; 0 means unlimited. Format-only repair stays bounded.
DREAMATIC_AGENT_MAX_TURNS=0
DREAMATIC_AGENT_MAX_TOOL_CALLS=0
DREAMATIC_AGENT_FIRST_RESPONSE_TIMEOUT_MS=180000
DREAMATIC_AGENT_IDLE_TIMEOUT_MS=90000
DREAMATIC_AGENT_TOOL_TIMEOUT_MS=120000
# Optional role total-limit overrides: DREAMATIC_ORCHESTRATOR_TIMEOUT_MS,
# DREAMATIC_ANALYST_TIMEOUT_MS, DREAMATIC_DESIGNER_TIMEOUT_MS.

# Optional installed Chrome/Chromium executable for page_preview (no auto-download).
# DREAMATIC_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional local PDF enhancement; no OCR or model calls, off by default.
DREAMATIC_PDF_ENHANCE=false
# Defaults to .venv-documents/bin/python in the project directory.
DREAMATIC_DOCUMENT_PYTHON=
