PORT=4310
HOST=127.0.0.1
DREAMATIC_MODE=live
DREAMATIC_LANGUAGE=zh
# Prefer the grouped Models & settings dialog. Saved settings take precedence.
# Model fields are retained for the settings UI only; no model calls are made.
DREAMATIC_MODEL_MODE=openai
DREAMATIC_BASE_URL=
DREAMATIC_MODEL=
DREAMATIC_API_KEY=
DREAMATIC_VISION=true
# Optional saved profiles for the existing settings UI.
DREAMATIC_ANALYST_MODEL_MODE=openai-compatible
DREAMATIC_ANALYST_BASE_URL=
DREAMATIC_ANALYST_MODEL=
DREAMATIC_ANALYST_API_KEY=
DREAMATIC_ANALYST_VISION=true
DREAMATIC_DESIGNER_MODEL_MODE=openai-compatible
DREAMATIC_DESIGNER_BASE_URL=
DREAMATIC_DESIGNER_MODEL=
DREAMATIC_DESIGNER_API_KEY=
DREAMATIC_DESIGNER_VISION=true
DREAMATIC_ACCESS_TOKEN=

# Optional installed Chrome/Chromium executable for browser preview (no auto-download).
# DREAMATIC_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional local PDF enhancement; no OCR or model calls, off by default.
DREAMATIC_PDF_ENHANCE=false
# Defaults to .venv-documents/bin/python in the project directory.
DREAMATIC_DOCUMENT_PYTHON=
