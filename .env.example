PORT=4310
HOST=127.0.0.1
DREAMATIC_MODE=live
DREAMATIC_LANGUAGE=zh
# Prefer the grouped Models & settings dialog. Saved settings take precedence.
# OpenAI uses Pi Responses; openai-compatible uses Pi Chat Completions.
DREAMATIC_MODEL_MODE=openai
DREAMATIC_BASE_URL=
DREAMATIC_MODEL=
DREAMATIC_API_KEY=
DREAMATIC_VISION=true
# Optional independent Analyst and Designer profiles; unset inherits reasoning.
DREAMATIC_ANALYST_MODEL_MODE=openai-compatible
DREAMATIC_ANALYST_BASE_URL=
DREAMATIC_ANALYST_MODEL=
DREAMATIC_ANALYST_API_KEY=
DREAMATIC_ANALYST_VISION=true
DREAMATIC_DESIGNER_MODEL_MODE=openai-compatible
DREAMATIC_DESIGNER_BASE_URL=
DREAMATIC_DESIGNER_MODEL=
DREAMATIC_DESIGNER_API_KEY=
DREAMATIC_DESIGNER_VISION=true
DREAMATIC_ACCESS_TOKEN=

# Optional multi-user mode: issue personal access tokens with scripts/user-access.mjs.
# The JSON file stores {"user-id":"SHA-256 token hash"}; it is read at startup.
# When enabled, the shared ACCESS_TOKEN and global model settings are not used.
# DREAMATIC_USERS_FILE=/srv/dreamatic/private/users.json
# Administrator-approved model base URLs; required in multi-user mode.
# DREAMATIC_ALLOWED_MODEL_URLS='["https://your-gateway.example/v1"]'
# Set true behind an HTTPS reverse proxy; loopback HTTP tests leave this unset.
# DREAMATIC_COOKIE_SECURE=true

# Optional installed Chrome/Chromium executable for browser preview (no auto-download).
# DREAMATIC_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional local PDF enhancement; no OCR or model calls, off by default.
DREAMATIC_PDF_ENHANCE=false
# Defaults to .venv-documents/bin/python in the project directory.
DREAMATIC_DOCUMENT_PYTHON=

# Server admission control (one backend process per workspace).
# Separate upload/parse/generation limits; excess work queues or receives HTTP 503.
DREAMATIC_GENERATION_CONCURRENCY=4
DREAMATIC_GENERATION_QUEUE_SIZE=100
DREAMATIC_IMPORT_CONCURRENCY=2
DREAMATIC_IMPORT_QUEUE_SIZE=20
DREAMATIC_UPLOAD_CONCURRENCY=4
DREAMATIC_QUEUE_WAIT_MS=300000
DREAMATIC_UPLOAD_TIMEOUT_MS=120000

# Equivalent keys for ONE model profile. Optional JSON arrays, maximum 16 keys.
# When provided, API_KEYS takes precedence over the profile's API_KEY.
# Never combine different users' private keys into a shared pool.
# DREAMATIC_API_KEYS='["replace-key-a","replace-key-b"]'
# DREAMATIC_ANALYST_API_KEYS='["replace-analyst-key-a","replace-analyst-key-b"]'
# DREAMATIC_DESIGNER_API_KEYS='["replace-designer-key-a","replace-designer-key-b"]'
DREAMATIC_MODEL_CONCURRENCY_PER_KEY=4
DREAMATIC_MODEL_QUEUE_SIZE_PER_KEY=100
# Requests/minute, evenly spaced; 0 means no additional rate cap.
DREAMATIC_MODEL_RPM_PER_KEY=0
DREAMATIC_MODEL_COOLDOWN_MS=30000
DREAMATIC_MODEL_MAX_CREDENTIALS=4096
